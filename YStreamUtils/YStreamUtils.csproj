<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <InvariantGlobalization>true</InvariantGlobalization>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Google.Apis.Auth" Version="1.76.0" />
        <PackageReference Include="Google.Apis.YouTube.v3" Version="1.76.0.4249" />
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
        <PackageReference Include="Jint" Version="4.16.1" />

        <PackageReference Include="Microsoft.AspNetCore.SpaServices.Extensions" Version="10.0.11" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <Target Name="EnsureNpmInstall" BeforeTargets="Build" Condition="Exists('frontend\package.json') And !Exists('frontend\node_modules')">
        <Message Importance="high" Text="Installing frontend dependencies using 'npm install'..." />
        <Exec Command="npm install" WorkingDirectory="frontend" />
    </Target>

    <ItemGroup>
        <Compile Remove="..\frontend\node_modules\**" />
        <Compile Remove="..\frontend\dist\**" />
    </ItemGroup>

    <Target Name="PublishFrontend" AfterTargets="ComputeFilesToPublish">
        <Exec Command="npm install" WorkingDirectory="..\frontend" />
        <Exec Command="npm run build" WorkingDirectory="..\frontend" />

        <ItemGroup>
            <DistFiles Include="..\frontend\dist\**\*" />
            <ResolvedFileToPublish Include="@(DistFiles)">
                <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
                <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
            </ResolvedFileToPublish>
        </ItemGroup>
    </Target>

</Project>
