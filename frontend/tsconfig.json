{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true,
    "paths": {
      "$lib/*": ["./src/lib/*"],
      "$bindings/*": ["./bindings/*"]
    },
  },
  "include": ["src/**/*.ts", "src/**/*.js", "src/**/*.svelte", "bindings"],
}
