@using BlazorMonaco
@using BlazorMonaco.Editor
@using BlazorMonaco.Languages
@using System.Text.Json
@using YScriptEngine.Lsp.Roslyn
@implements IDisposable
@inject IJSRuntime JsRuntime
@inject RoslynLspProvider LspProvider
@inject ILogger<CodeEditor> Logger

<div class="editor-container" style="height: 500px;">
    <StandaloneCodeEditor @ref="_editor"
                          Id="csharp-script-editor"
                          ConstructionOptions="EditorConstructionOptions"
                          OnDidInit="OnEditorInitialized"
                          OnDidChangeModelContent="OnCodeChanged"
                          CssClass="full"/>
</div>

<script type="module">
    import {createHighlighter} from "https://esm.sh/shiki";
    import {shikiToMonaco} from "https://esm.sh/@@shikijs/monaco"

    window.initializeShikiHighlighter = async function () {
        if (typeof monaco === 'undefined') {
            setTimeout(window.initializeShikiHighlighter, 50);
            return;
        }

        const highlighter = await createHighlighter({
            themes: ['dark-plus'],
            langs: ['csharp']
        });

        shikiToMonaco(highlighter, monaco);
        monaco.editor.setTheme('dark-plus');
    };
</script>

<style>
    .full {
        width: 100%;
        height: 100%;
    }
</style>

@code {
    private StandaloneCodeEditor? _editor;
    private CancellationTokenSource? _completionCts;
    private Timer? _debounceTimer;
    private bool _isInitialized;

    [Parameter, EditorRequired] public Type ContextType { get; set; } = typeof(object);

    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    
    public async Task<string> GetValueAsync()
    {
        var model = await _editor?.GetModel()! ?? new TextModel();
        return await model.GetValue(EndOfLinePreference.TextDefined, false);
    }

    private StandaloneEditorConstructionOptions EditorConstructionOptions(StandaloneCodeEditor editor)
    {
        return new StandaloneEditorConstructionOptions
        {
            AutomaticLayout = true,
            Language = "csharp",
            Value = Value,
            Theme = "dark-plus",
            FormatOnType = true,
            FormatOnPaste = true,
            SemanticHighlightingEnabled = true
        };
    }
    
    

    private async Task OnEditorInitialized()
    {
        await InitializeEditorFeatures();
        await RunDiagnosticsAsync();
    }

    private async Task InitializeEditorFeatures()
    {
        var selector = new LanguageSelector("csharp");

        var completionProvider = new CompletionItemProvider(
            triggerCharacters: [".", " "],
            provideCompletionItems: async (_, position, _) =>
            {
                if (_completionCts is not null) await _completionCts.CancelAsync();
                _completionCts = new CancellationTokenSource();

                try
                {
                    var model = await _editor?.GetModel()!;
                    if (model == null) return new CompletionList { Suggestions = [] };

                    var cursorOffset = await model.GetOffsetAt(position);
                    var currentCode = await model.GetValue(EndOfLinePreference.TextDefined, preserveBOM: false);

                    var roslynItems = await LspProvider.GetCompletionsAsync(currentCode, cursorOffset, ContextType, _completionCts.Token);

                    var wordInfo = await model.GetWordUntilPosition(position);
                    var replaceRange = new BlazorMonaco.Range(position.LineNumber, wordInfo.StartColumn, position.LineNumber, wordInfo.EndColumn);

                    var serializerOptions = new JsonSerializerOptions
                    {
                        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
                    };

                    var suggestions = roslynItems.Select(item => new CompletionItem
                    {
                        Label = JsonSerializer.SerializeToElement(item.Label, serializerOptions),
                        Kind = MapRoslynTagToMonacoKind(item.Type),
                        InsertText = item.Label,
                        Detail = item.Detail,
                        Range = JsonSerializer.SerializeToElement(replaceRange, serializerOptions)
                    }).ToList();

                    return new CompletionList { Suggestions = suggestions };
                }
                catch (OperationCanceledException)
                {
                    return new CompletionList { Suggestions = [] };
                }
            },
            resolveCompletionItem: null
        );

        await BlazorMonaco.Languages.Global.RegisterCompletionItemProvider(
            JsRuntime, selector, completionProvider
        );

        var formatterProvider = new DocumentFormattingEditProvider(
            displayName: "Roslyn C# Formatter",
            provideDocumentFormattingEditsDelegate: async (_, _) =>
            {
                var model = await _editor?.GetModel()!;
                if (model == null) return [];

                var currentCode = await model.GetValue(EndOfLinePreference.TextDefined, preserveBOM: false);
                var formattedCode = await LspProvider.FormatCodeAsync(currentCode, ContextType, CancellationToken.None);
                var fullRange = await model.GetFullModelRange();

                return
                [
                    new TextEdit { Range = fullRange, Text = formattedCode }
                ];
            }
        );

        await BlazorMonaco.Languages.Global.RegisterDocumentFormattingEditProvider(
            JsRuntime, selector, formatterProvider
        );

        var hoverProvider = new HoverProvider(async (_, position, _) =>
        {
            var model = await _editor?.GetModel()!;
            if (model == null) return new Hover();

            var cursorOffset = await model.GetOffsetAt(position);
            var currentCode = await model.GetValue(EndOfLinePreference.TextDefined, false);

            var hoverText = await LspProvider.GetHoverInfoAsync(currentCode, cursorOffset, ContextType, CancellationToken.None);
            if (string.IsNullOrEmpty(hoverText)) return new Hover();

            var wordInfo = await model.GetWordUntilPosition(position);
            var replaceRange = new BlazorMonaco.Range(position.LineNumber, wordInfo.StartColumn, position.LineNumber, wordInfo.EndColumn);

            var markdown = new MarkdownString
            {
                Value = $"```csharp\n{hoverText}\n```",
                IsTrusted = true
            };

            return new Hover
            {
                Contents = [markdown],
                Range = replaceRange
            };
        });

        await BlazorMonaco.Languages.Global.RegisterHoverProviderAsync(JsRuntime, selector, hoverProvider);

        var codeActionProvider = new CodeActionProvider(async (modelUri, range, _) =>
            {
                var model = await _editor?.GetModel()!;
                if (model == null) return new CodeActionList { Actions = [] };

                var startOffset = await model.GetOffsetAt(new Position
                {
                    LineNumber = range.StartLineNumber,
                    Column = range.StartColumn
                });
                var endOffset = await model.GetOffsetAt(new Position
                {
                    LineNumber = range.EndLineNumber,
                    Column = range.EndColumn
                });

                var currentCode = await model.GetValue(EndOfLinePreference.TextDefined, preserveBOM: false);
                var quickActions = await LspProvider.GetQuickActionsAsync(
                    currentCode, startOffset, endOffset, ContextType, CancellationToken.None);

                var actions = quickActions.Select(qa => new CodeAction
                {
                    Title = qa.Title,
                    Kind = "quickfix",
                    IsPreferred = true,
                    Edit = new WorkspaceEdit
                    {
                        Edits =
                        [
                            new WorkspaceTextEdit
                            {
                                ResourceUri = modelUri,
                                TextEdit = new TextEditWithOptions
                                {
                                    Range = new BlazorMonaco.Range(
                                        qa.StartLine,
                                        qa.StartColumn,
                                        qa.EndLine,
                                        qa.EndColumn),
                                    Text = qa.NewText
                                }
                            }
                        ]
                    }
                }).ToList();

                return new CodeActionList
                {
                    Actions = actions
                };
            }
        );

        await BlazorMonaco.Languages.Global.RegisterCodeActionProvider(
            JsRuntime, selector, codeActionProvider
        );

        _isInitialized = true;

        await RunDiagnosticsAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_isInitialized)
        {
            await RunDiagnosticsAsync();
            if (Value != null)
            {
                var model = await _editor?.GetModel()!;
                if (model != null)
                {
                    var currentText = await model.GetValue(EndOfLinePreference.TextDefined, false);
                    if (currentText != Value)
                    {
                        await model.SetValue(Value);
                    }
                }
            }
        }
    }


    private void OnCodeChanged(ModelContentChangedEvent e)
    {
        _debounceTimer?.Dispose();
        _debounceTimer = new Timer(DebounceTimerHandler, null, TimeSpan.FromMilliseconds(400), Timeout.InfiniteTimeSpan);
    }
    private async void DebounceTimerHandler(object? state)
    {
        try
        {
            await InvokeAsync(async () =>
            {
                await RunDiagnosticsAsync();
                var currentText = await GetValueAsync();
                await ValueChanged.InvokeAsync(currentText);
            });
        }
        catch (Exception ex)
        {
            Logger.LogError($"Diagnostics background error: {ex.Message}");
        }
    }

    private async Task RunDiagnosticsAsync()
    {
        if (!_isInitialized || _editor == null) return;

        var model = await _editor.GetModel();
        if (model == null) return;

        await RunDiagnostics(model);
    }

    private async Task RunDiagnostics(TextModel model)
    {
        var currentCode = await model.GetValue(EndOfLinePreference.TextDefined, false);
        var diagnostics = await LspProvider.GetDiagnosticsAsync(currentCode, ContextType, CancellationToken.None);

        var markers = new List<MarkerData>();
        foreach (var diag in diagnostics)
        {
            var startPos = await model.GetPositionAt(diag.From);
            var endPos = await model.GetPositionAt(diag.To);

            markers.Add(new MarkerData
            {
                Code = string.IsNullOrEmpty(diag.Code)
                    ? null
                    : JsonSerializer.SerializeToElement(diag.Code),
                Severity = diag.Severity.ToLower() == "error" ? MarkerSeverity.Error : MarkerSeverity.Warning,
                Message = diag.Message,
                StartLineNumber = startPos.LineNumber,
                StartColumn = startPos.Column,
                EndLineNumber = endPos.LineNumber,
                EndColumn = endPos.Column
            });
        }

        await BlazorMonaco.Editor.Global.SetModelMarkers(JsRuntime, model, "roslyn-diagnostics", markers);
    }

    private static CompletionItemKind MapRoslynTagToMonacoKind(string tag)
    {
        return tag.ToLower() switch
        {
            "class" => CompletionItemKind.Class,
            "method" => CompletionItemKind.Method,
            "property" => CompletionItemKind.Property,
            "field" => CompletionItemKind.Field,
            "keyword" => CompletionItemKind.Keyword,
            _ => CompletionItemKind.Variable
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JsRuntime.InvokeVoidAsync("initializeShikiHighlighter");
        }
    }

    public void Dispose()
    {
        _completionCts?.Dispose();
        _debounceTimer?.Dispose();
    }

}
