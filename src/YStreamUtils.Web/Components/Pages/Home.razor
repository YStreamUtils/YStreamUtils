@page "/"
@using YStreamUtils.Core.Events
@using YStreamUtils.Web.Components.Shared
@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

<p>Welcome to your new app.</p>

<StreamRender TEventType="string" EventKey="@EventKey.ApplicationLog" 
              MaxBufferLimit="1000" 
              MaxHeight="400px">
  <ItemTemplate Context="log">
    <div class="log-item-row" style=" height: 30px;">
      <span>@log.ToString()</span>
    </div>
  </ItemTemplate>
</StreamRender>

<CodeEditor ScriptEventKey="EventKey.StreamChatMessage"/>