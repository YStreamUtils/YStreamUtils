  "components": {
    "schemas": {
      "ConnectUrlResponse": {
        "required": [
          "url"
        ],
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        }
      },
      "DocumentationConfig": {
        "required": [
          "description"
        ],
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          }
        }
      },
      "EventKey": {
        "enum": [
          "ManualInvoke",
          "StreamChatMessage",
          "YoutubeSuperChat",
          "ApplicationLog"
        ]
      },
      "OAuthConfigInput": {
        "required": [
          "tenantId",
          "platform",
          "clientId",
          "clientSecret"
        ],
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string"
          },
          "platform": {
            "$ref": "#/components/schemas/Platform"
          },
          "clientId": {
            "type": "string"
          },
          "clientSecret": {
            "type": "string"
          }
        }
      },
      "Platform": {
        "enum": [
          "YouTube",
          "Twitch"
        ]
      },
      "PluginManifest": {
        "required": [
          "name",
          "version",
          "entryPoint",
          "permissions",
          "authors",
          "source",
          "documentation"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "entryPoint": {
            "type": "string"
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "authors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "$ref": "#/components/schemas/SourceConfig"
          },
          "documentation": {
            "$ref": "#/components/schemas/DocumentationConfig"
          }
        }
      },
      "PluginSettings": {
        "type": "object",
        "properties": {
          "repos": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "RegisterScriptRequest": {
        "required": [
          "topic",
          "scriptId",
          "rawJsString"
        ],
        "type": "object",
        "properties": {
          "topic": {
            "$ref": "#/components/schemas/EventKey"
          },
          "scriptId": {
            "type": "string"
          },
          "rawJsString": {
            "type": "string"
          }
        }
      },
      "ScriptMetadataResponse": {
        "required": [
          "definitions"
        ],
        "type": "object",
        "properties": {
          "definitions": {
            "type": "string"
          }
        }
      },
      "Settings": {
        "type": "object",
        "properties": {
          "ui": {
            "$ref": "#/components/schemas/UiSettings"
          },
          "plugins": {
            "$ref": "#/components/schemas/PluginSettings"
          }
        }
      },
      "SourceConfig": {
        "required": [
          "repository",
          "owner"
        ],
        "type": "object",
        "properties": {
          "repository": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          }
        }
      },
      "UiSettings": {
        "type": "object",
        "properties": {
          "theme": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "fullyCloseSidebar": {
            "type": "boolean"
          }
        }
      },
      "UserProfile": {
        "required": [
          "displayName",
          "avatarUrl",
          "channelId",
          "handle"
        ],
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string"
          },
          "avatarUrl": {
            "type": "string"
          },
          "channelId": {
            "type": "string"
          },
          "handle": {
            "type": "string"
          }
        }
      },
      "UserScript": {
        "type": "object",
        "properties": {
          "scriptId": {
            "type": "string"
          },
          "topic": {
            "$ref": "#/components/schemas/EventKey"
          },
          "rawJsString": {
            "type": "string"
          },
          "isEnabled": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "YStreamUtils"
    }
  ]
}